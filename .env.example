# Database
DATABASE_URL="postgresql://user:password@localhost:5432/edubridge?schema=public"

# NextAuth
AUTH_SECRET="your-super-secret-key-change-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EduBridge"

# EmailJS (OTP verification) — template must include {{passcode}} or {{message}}
EMAILJS_SERVICE_ID="your-emailjs-service-id"
EMAILJS_TEMPLATE_ID="your-emailjs-template-id"
EMAILJS_PUBLIC_KEY="your-emailjs-public-key"
EMAILJS_PRIVATE_KEY="your-emailjs-private-key"
# Set to true to log OTP codes in Railway logs (disable in production)
DEBUG_OTP="false"
