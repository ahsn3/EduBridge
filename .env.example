# Database
DATABASE_URL="postgresql://user:password@localhost:5432/edubridge?schema=public"

# NextAuth
AUTH_SECRET="your-super-secret-key-change-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EduBridge"

# EmailJS (OTP verification)
# Template must use {{email}} for recipient and {{passcode}} for the OTP code.
# Create at https://dashboard.emailjs.com — connect Email Service, then copy IDs from template settings.
EMAILJS_SERVICE_ID="service_xxxxxxx"
EMAILJS_TEMPLATE_ID="template_xxxxxxx"
EMAILJS_PUBLIC_KEY="your-public-key"
EMAILJS_PRIVATE_KEY="your-private-key"
# Set to true to log OTP codes in Railway logs (disable in production)
DEBUG_OTP="false"
