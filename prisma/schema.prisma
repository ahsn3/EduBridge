generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  PAYPAL
  CASH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ContentFileType {
  PDF
  PPT
  DOCX
  VIDEO
  IMAGE
  LINK
  ASSIGNMENT
}

enum InstructorApprovalStatus {
  PROFILE_INCOMPLETE
  PENDING_REVIEW
  APPROVED
  REJECTED
  INFO_REQUESTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  nameAr        String?
  nameEn        String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role           @default(STUDENT)
  status        AccountStatus  @default(ACTIVE)
  avatar        String?
  phone         String?
  bio           String?
  bioAr         String?
  bioEn         String?
  referralCode  String?   @unique
  referredBy    String?
  locale        String    @default("ar")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  courses       Course[]       @relation("InstructorCourses")
  enrollments   Enrollment[]
  notifications Notification[]
  payments      Payment[]
  attendances   Attendance[]
  submissions   AssignmentSubmission[]
  quizAttempts  QuizAttempt[]
  certificates  Certificate[]
  announcements Announcement[] @relation("AnnouncementAuthor")
  instructorProfile InstructorProfile?
  uploadedFiles   ContentFile[]  @relation("UploadedFiles")
  passwordResets  PasswordReset[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}


model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String
  payload   Json
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@map("email_otps")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  nameEn      String
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  courses Course[]

  @@map("categories")
}

model Course {
  id           String   @id @default(cuid())
  title        String
  titleAr      String
  titleEn      String
  description  String   @db.Text
  descriptionAr String  @db.Text
  descriptionEn String  @db.Text
  thumbnail    String?
  price        Float    @default(0)
  isPublished  Boolean  @default(false)
  level        String   @default("beginner")
  duration     Int      @default(0)
  instructorId String
  categoryId   String?
  subjectId    String?
  isFeatured   Boolean  @default(false)
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor    User           @relation("InstructorCourses", fields: [instructorId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  enrollments   Enrollment[]
  liveSessions  LiveSession[]
  materials     Material[]
  assignments   Assignment[]
  quizzes       Quiz[]
  announcements Announcement[]
  certificates  Certificate[]
  contentFiles  ContentFile[]

  @@map("courses")
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  status    EnrollmentStatus @default(PENDING)
  progress  Float            @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LiveSession {
  id             String   @id @default(cuid())
  courseId       String
  title          String
  titleAr        String?
  titleEn        String?
  googleMeetLink String?
  sessionDate    DateTime
  duration       Int      @default(60)
  description    String?
  recordingUrl   String?
  createdAt      DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("live_sessions")
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  sessionId String
  status    AttendanceStatus @default(ABSENT)
  joinedAt  DateTime?
  createdAt DateTime         @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@map("attendances")
}

model Material {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  titleAr   String?
  titleEn   String?
  fileUrl   String
  fileType  String   @default("pdf")
  fileSize  Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  titleAr     String?
  titleEn     String?
  description String   @db.Text
  dueDate     DateTime
  maxScore    Int      @default(100)
  createdAt   DateTime @default(now())

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  content      String?  @db.Text
  fileUrl      String?
  score        Int?
  feedback     String?
  submittedAt  DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@map("assignment_submissions")
}

model Quiz {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  titleAr   String?
  titleEn   String?
  duration  Int      @default(30)
  createdAt DateTime @default(now())

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  questionAr    String?
  questionEn    String?
  options       Json
  correctAnswer Int
  order         Int    @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int      @default(0)
  answers     Json
  completedAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  title      String
  titleAr    String?
  titleEn    String?
  message    String
  messageAr  String?
  messageEn  String?
  readStatus Boolean  @default(false)
  type       String   @default("info")
  link       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  amount        Float
  paymentMethod PaymentMethod @default(CREDIT_CARD)
  paymentStatus PaymentStatus @default(PENDING)
  couponCode    String?
  discount      Float         @default(0)
  description   String?
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   @default("percentage")
  discountValue Float
  maxUses       Int?
  usedCount     Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("coupons")
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  titleAr   String?
  titleEn   String?
  content   String   @db.Text
  contentAr String?  @db.Text
  contentEn String?  @db.Text
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@map("announcements")
}

model Certificate {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  certificateUrl String?
  issuedAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  nameEn    String?
  role      String
  roleAr    String?
  roleEn    String?
  content   String
  contentAr String
  contentEn String
  avatar    String?
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  nameEn      String
  description String?
  descriptionAr String?
  descriptionEn String?
  price       Float
  features    Json
  featuresAr  Json
  featuresEn  Json
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("pricing_plans")
}

model University {
  id        String       @id @default(cuid())
  nameAr    String
  nameEn    String
  slug      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  faculties Faculty[]

  @@map("universities")
}

model Faculty {
  id           String       @id @default(cuid())
  universityId String
  nameAr       String
  nameEn       String
  slug         String
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  university University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments Department[]

  @@unique([universityId, slug])
  @@map("faculties")
}

model Department {
  id        String       @id @default(cuid())
  facultyId String
  nameAr    String
  nameEn    String
  slug      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  faculty       Faculty        @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  academicYears AcademicYear[]

  @@unique([facultyId, slug])
  @@map("departments")
}

model AcademicYear {
  id           String       @id @default(cuid())
  departmentId String
  nameAr       String
  nameEn       String
  yearNumber   Int          @default(1)
  order        Int          @default(0)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects   Subject[]

  @@map("academic_years")
}

model Subject {
  id             String       @id @default(cuid())
  academicYearId String
  nameAr         String
  nameEn         String
  slug           String
  descriptionAr  String?
  descriptionEn  String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courses      Course[]

  @@unique([academicYearId, slug])
  @@map("subjects")
}

model InstructorProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  universityId       String?
  facultyId          String?
  departmentId       String?
  universityName     String?
  facultyName        String?
  departmentName     String?
  academicPositionAr String?
  academicPositionEn String?
  cvUrl              String?
  profileCompleted   Boolean                  @default(false)
  approvalStatus     InstructorApprovalStatus @default(PROFILE_INCOMPLETE)
  adminNotes         String?                  @db.Text
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("instructor_profiles")
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
  @@map("password_resets")
}

model ContentFile {
  id           String          @id @default(cuid())
  courseId     String?
  uploadedById String
  titleAr      String
  titleEn      String
  fileUrl      String
  fileType     ContentFileType @default(PDF)
  fileSize     Int?
  moduleName   String?
  weekNumber   Int?
  chapterName  String?
  status       RecordStatus    @default(ACTIVE)
  downloadCount Int            @default(0)
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  uploadedBy User    @relation("UploadedFiles", fields: [uploadedById], references: [id])

  @@map("content_files")
}
