{
  "name": "edubridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "start:prod": "sh scripts/start.sh",
    "railway:setup": "prisma db push --accept-data-loss && tsx prisma/seed.ts",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:resolve": "prisma migrate resolve --rolled-back 20250611120000_init",
    "db:sync": "prisma migrate deploy || prisma db push",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "ensure-admins": "tsx scripts/ensure-admins.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
